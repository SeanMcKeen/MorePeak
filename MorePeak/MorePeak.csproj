<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>MorePeak</RootNamespace>
    <AssemblyName>MorePeak</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Single source of truth for the mod version. BepInEx.PluginInfoProps turns these
         into MyPluginInfo constants, and build-package.ps1 reads Version from here to
         stamp the Thunderstore manifest, folder name, and zip. Bump it in one place. -->
    <Version>2.0.0</Version>
    <BepInExPluginGuid>com.smckeen.morepeak</BepInExPluginGuid>
    <BepInExPluginName>MorePeak</BepInExPluginName>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
    <!-- Local copies of game Managed DLLs live next to this project (refreshed from new_gamefiles/). -->
    <GameRefDir>$(MSBuildThisFileDirectory)</GameRefDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.36" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\settings-cog.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRefDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameRefDir)PhotonUnityNetworking.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameRefDir)Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameRefDir)Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameRefDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>$(GameRefDir)Zorro.Core.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
